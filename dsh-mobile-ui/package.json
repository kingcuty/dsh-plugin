{
  "name": "dsh-mobile-ui",
  "version": "0.2.20",
  "description": "Mobile UI optimisation for the DSH Web GUI: an off-canvas sidebar drawer and a collapsible composer, for iOS / Android / HarmonyOS phone frames.",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "DEPLOY.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mobile",
    "web-ui"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
